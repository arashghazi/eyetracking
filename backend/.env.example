EYETRACKING_DATABASE_URL=sqlite:///./eyetracking_dev.db
EYETRACKING_JWT_SECRET=replace-with-a-long-random-secret
EYETRACKING_JWT_EXPIRE_MINUTES=120
EYETRACKING_BOOTSTRAP_ADMIN_EMAIL=admin@example.org
EYETRACKING_BOOTSTRAP_ADMIN_PASSWORD=replace-me-please
# AI content generation (step 5). Fake providers need no key and cost nothing.
EYETRACKING_AI_TEXT_PROVIDER=fake            # fake | anthropic
EYETRACKING_AI_TEXT_MODEL=claude-opus-5-5
EYETRACKING_ANTHROPIC_API_KEY=
EYETRACKING_AI_VIDEO_PROVIDER=fake           # fake | heygen
EYETRACKING_HEYGEN_API_KEY=
EYETRACKING_HEYGEN_COST_PER_MINUTE_UNITS=1.0
EYETRACKING_AI_WORKER_ENABLED=false
EYETRACKING_AI_WORKER_INTERVAL_S=5
# Live avatar (step 7). Development providers need no key and cost nothing.
EYETRACKING_LIVE_REPLY_PROVIDER=fake        # fake | anthropic
EYETRACKING_LIVE_REPLY_MODEL=claude-opus-5-5
EYETRACKING_LIVE_REPLY_EFFORT=low
EYETRACKING_STT_PROVIDER=fake               # fake | whisper_http (a Whisper-compatible server on this computer)
EYETRACKING_STT_BASE_URL=
EYETRACKING_STT_MODEL=whisper-1
EYETRACKING_STT_API_KEY=
EYETRACKING_LIVE_AVATAR_PROVIDER=fake
